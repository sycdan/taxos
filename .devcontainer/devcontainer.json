{
	"name": "Taxos",
	"dockerComposeFile": [
		"../docker-compose.development.yml"
	],
	"service": "dev",
	"remoteUser": "vscode",
	"workspaceFolder": "/workspaces/taxos",
	"mounts": [
		"source=${localEnv:USERPROFILE}/.config/git,target=/home/vscode/.config/git,type=bind,consistency=cached",
		"source=${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
	],
	"containerEnv": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"DrBlury.protobuf-vsc",
				"charliermarsh.ruff",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			]
		}
	},
	"shutdownAction": "none"
}