FROM mcr.microsoft.com/devcontainers/python:3.0.4-3.14-bookworm

WORKDIR /app

COPY ./requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

RUN pip install --no-cache-dir debugpy

ENV PYTHONPATH=/app

# Launch via debugpy module so it properly follows Flask's reloader child process.
# VS Code can attach on port 5678 at any time.
CMD ["python", "-Xfrozen_modules=off", "-m", "debugpy", "--listen", "0.0.0.0:5678", "runserver.py"]
