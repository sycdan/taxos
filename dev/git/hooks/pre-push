#!/bin/bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "==> Checking for clean working directory..."
if [ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]; then
  echo "❌ Working directory is not clean. Commit or stash changes before pushing." >&2
  exit 1
fi

echo "==> Checking Python format (ruff)..."
if ! ruff format --check "$REPO_ROOT/backend" "$REPO_ROOT/dev"; then
  echo "❌ Python formatting issues found. Run: ruff format backend dev" >&2
  exit 1
fi

echo "==> Checking Python lint (ruff)..."
if ! ruff check "$REPO_ROOT/backend" "$REPO_ROOT/dev"; then
  echo "❌ Python lint issues found. Run: ruff check --fix backend dev" >&2
  exit 1
fi

echo "==> Checking frontend lint (eslint)..."
if ! (cd "$REPO_ROOT/frontend" && npm run lint); then
  echo "❌ Frontend lint issues found. Run: cd frontend && npm run lint" >&2
  exit 1
fi

echo "==> Running tests..."
if ! (cd "$REPO_ROOT" && scaf call dev/test); then
  echo "❌ Tests failed. Run: dev.test" >&2
  exit 1
fi
echo "==> Building frontend..."
if ! (cd "$REPO_ROOT/frontend" && npm run build); then
  echo "❌ Frontend build failed. Run: cd frontend && npm run build" >&2
  exit 1
fi
echo "✅ All checks passed."
